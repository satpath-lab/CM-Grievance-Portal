# MongoDB connection string.
# Local:  mongodb://localhost:27017/delhi_grievance
# Atlas (free tier, recommended — see README "Database setup" section):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/delhi_grievance
MONGODB_URI=mongodb://localhost:27017/delhi_grievance

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string-in-production

PORT=4000

# MCD311 / Open311 integration — OPTIONAL.
# If left blank, the system runs in graceful-degradation "mock mode":
# all Open311 endpoints work normally and return clearly-labeled mock
# data instead of failing. Fill these in only if/when the government
# provides real MCD311 API credentials.
MCD311_API_BASE_URL=
MCD311_API_KEY=

# Groq AI — free tier at console.groq.com (no credit card required).
# Primary model: llama-3.3-70b-versatile (best Hindi/Hinglish/English understanding)
# Fast model:    llama-3.1-8b-instant (used for live NLP preview as citizen types)
# Without this key the system runs fully: TF-IDF Naive Bayes classifier is the fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Shared secret for the social-media auto-extraction webhook
# (POST /api/social/webhook). Any free automation tool that can see a
# tagged post — an IFTTT applet, a Zapier free-tier zap, or a simple
# script — sends it here with this secret in the X-Webhook-Secret
# header. There is no genuinely free way to monitor X/Twitter live in
# 2026 (the official free tier is write-only), so this is the
# integration point for whatever free/manual discovery mechanism you
# wire up; the verification + auto-filing logic behind it is real.
SOCIAL_WEBHOOK_SECRET=

# Notification service — see server/src/services/notificationService.ts
# for full rationale on each channel's actual status (which are real
# vs. which are documented stubs ready for later integration).

# SMS via Twilio — NOT free at production volume. Leave blank to no-op.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Staff email via Resend — genuinely free, 3,000 emails/month, no card.
# Sign up at resend.com. Used for officer/admin notifications (citizens
# are tracked by phone only, not email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
